<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.10">
 <model name="mujoco_uav_delta">
  <static>false</static>
  <!-- Self broadphase is enabled only with SelectiveDeltaCollisionSystem.
       The system suppresses UAV/UAV and all internal Delta/helper pairs. -->
  <self_collide>true</self_collide>
  <plugin filename="libSelectiveDeltaCollisionSystem.so" name="SelectiveDeltaCollisionSystem"/>
  <!-- motorConstant preserves the previous 9.75 N per-rotor maximum at
       1000 rad/s. Motor time constants remain provisional estimates. -->
  <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
   <jointName>rotor_0_joint</jointName>
   <linkName>uav_uav_prop_1</linkName>
   <turningDirection>ccw</turningDirection>
   <timeConstantUp>0.0125</timeConstantUp>
   <timeConstantDown>0.025</timeConstantDown>
   <maxRotVelocity>1000.0</maxRotVelocity>
   <motorConstant>9.75e-6</motorConstant>
   <momentConstant>0.0230666667</momentConstant>
   <commandSubTopic>command/motor_speed</commandSubTopic>
   <motorNumber>0</motorNumber>
   <rotorDragCoefficient>0</rotorDragCoefficient>
   <rollingMomentCoefficient>0</rollingMomentCoefficient>
   <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
   <motorType>velocity</motorType>
  </plugin>
  <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
   <jointName>rotor_1_joint</jointName>
   <linkName>uav_uav_prop_3</linkName>
   <turningDirection>ccw</turningDirection>
   <timeConstantUp>0.0125</timeConstantUp>
   <timeConstantDown>0.025</timeConstantDown>
   <maxRotVelocity>1000.0</maxRotVelocity>
   <motorConstant>9.75e-6</motorConstant>
   <momentConstant>0.0230666667</momentConstant>
   <commandSubTopic>command/motor_speed</commandSubTopic>
   <motorNumber>1</motorNumber>
   <rotorDragCoefficient>0</rotorDragCoefficient>
   <rollingMomentCoefficient>0</rollingMomentCoefficient>
   <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
   <motorType>velocity</motorType>
  </plugin>
  <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
   <jointName>rotor_2_joint</jointName>
   <linkName>uav_uav_prop_4</linkName>
   <turningDirection>cw</turningDirection>
   <timeConstantUp>0.0125</timeConstantUp>
   <timeConstantDown>0.025</timeConstantDown>
   <maxRotVelocity>1000.0</maxRotVelocity>
   <motorConstant>9.75e-6</motorConstant>
   <momentConstant>0.0230666667</momentConstant>
   <commandSubTopic>command/motor_speed</commandSubTopic>
   <motorNumber>2</motorNumber>
   <rotorDragCoefficient>0</rotorDragCoefficient>
   <rollingMomentCoefficient>0</rollingMomentCoefficient>
   <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
   <motorType>velocity</motorType>
  </plugin>
  <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
   <jointName>rotor_3_joint</jointName>
   <linkName>uav_uav_prop_2</linkName>
   <turningDirection>cw</turningDirection>
   <timeConstantUp>0.0125</timeConstantUp>
   <timeConstantDown>0.025</timeConstantDown>
   <maxRotVelocity>1000.0</maxRotVelocity>
   <motorConstant>9.75e-6</motorConstant>
   <momentConstant>0.0230666667</momentConstant>
   <commandSubTopic>command/motor_speed</commandSubTopic>
   <motorNumber>3</motorNumber>
   <rotorDragCoefficient>0</rotorDragCoefficient>
   <rollingMomentCoefficient>0</rollingMomentCoefficient>
   <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
   <motorType>velocity</motorType>
  </plugin>
  <frame name="delta_mount" attached_to="base_link">
   <pose relative_to="base_link">0 0 -0.1071 0 0 0</pose>
  </frame>
  <link name="base_link">
   <pose>0 0 0.1071 0 0 0</pose>
   <sensor name="imu_sensor" type="imu">
    <gz_frame_id>base_link</gz_frame_id>
    <always_on>1</always_on>
    <update_rate>500</update_rate>
    <imu>
     <angular_velocity>
      <x>
       <noise type="gaussian">
        <mean>0</mean>
        <stddev>0.0008726646</stddev>
       </noise>
      </x>
      <y>
       <noise type="gaussian">
        <mean>0</mean>
        <stddev>0.0008726646</stddev>
       </noise>
      </y>
      <z>
       <noise type="gaussian">
        <mean>0</mean>
        <stddev>0.0008726646</stddev>
       </noise>
      </z>
     </angular_velocity>
     <linear_acceleration>
      <x>
       <noise type="gaussian">
        <mean>0</mean>
        <stddev>0.00637</stddev>
       </noise>
      </x>
      <y>
       <noise type="gaussian">
        <mean>0</mean>
        <stddev>0.00637</stddev>
       </noise>
      </y>
      <z>
       <noise type="gaussian">
        <mean>0</mean>
        <stddev>0.00686</stddev>
       </noise>
      </z>
     </linear_acceleration>
    </imu>
   </sensor>
   <sensor name="magnetometer_sensor" type="magnetometer">
    <gz_frame_id>base_link</gz_frame_id>
    <always_on>1</always_on>
    <update_rate>100</update_rate>
    <magnetometer>
     <x>
      <noise type="gaussian">
       <mean>0</mean>
       <stddev>0.0001</stddev>
      </noise>
     </x>
     <y>
      <noise type="gaussian">
       <mean>0</mean>
       <stddev>0.0001</stddev>
      </noise>
     </y>
     <z>
      <noise type="gaussian">
       <mean>0</mean>
       <stddev>0.0001</stddev>
      </noise>
     </z>
    </magnetometer>
   </sensor>
   <sensor name="air_pressure_sensor" type="air_pressure">
    <gz_frame_id>base_link</gz_frame_id>
    <always_on>1</always_on>
    <update_rate>50</update_rate>
    <air_pressure>
     <pressure>
      <noise type="gaussian">
       <mean>0</mean>
       <stddev>3</stddev>
      </noise>
     </pressure>
    </air_pressure>
   </sensor>
   <sensor name="navsat_sensor" type="navsat">
    <gz_frame_id>base_link</gz_frame_id>
    <always_on>1</always_on>
    <update_rate>30</update_rate>
   </sensor>
   <inertial>
    <mass>1e-9</mass>
    <inertia>
     <ixx>1e-12</ixx>
     <iyy>1e-12</iyy>
     <izz>1e-12</izz>
     <ixy>0</ixy>
     <ixz>0</ixz>
     <iyz>0</iyz>
    </inertia>
   </inertial>
  </link>
  <frame name="rotor0" attached_to="base_link">
   <pose relative_to="base_link">0.1414 -0.1414 -0.0152 0 0 0</pose>
  </frame>
  <frame name="rotor1" attached_to="base_link">
   <pose relative_to="base_link">-0.1414 0.1414 -0.0152 0 0 0</pose>
  </frame>
  <frame name="rotor2" attached_to="base_link">
