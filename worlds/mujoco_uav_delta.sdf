<sdf version="1.9"><world name="mujoco_uav_delta">
  <physics name="dart_pgs" type="dart"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor><real_time_update_rate>2000</real_time_update_rate><dart><solver><solver_type>dantzig</solver_type></solver></dart></physics>
  <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
  <atmosphere type="adiabatic"/>
  <scene>
    <grid>true</grid>
    <ambient>0.4 0.4 0.4 1</ambient>
    <background>0.7 0.7 0.7 1</background>
    <shadows>true</shadows>
  </scene>
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
  <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
  <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
  <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
  <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
  <!-- A GUI grid is not physical geometry.  Keep an explicit static plane in
       the formal world so the airborne model receives real DART contacts. -->
  <model name="ground">
    <static>true</static>
    <link name="ground_link">
      <pose>0 0 0 0 0 0</pose>
      <collision name="ground_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
          <contact>
            <collide_bitmask>65535</collide_bitmask>
          </contact>
        </surface>
      </collision>
      <visual name="ground_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>100 100</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.70 0.70 0.70 1</ambient>
          <diffuse>0.80 0.80 0.80 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
      <sensor name="ground_contact_sensor" type="contact">
        <contact>
          <collision>ground_collision</collision>
          <topic>/mujoco_uav_delta/ground_contacts</topic>
        </contact>
        <always_on>true</always_on>
        <update_rate>500</update_rate>
      </sensor>
    </link>
  </model>
  <light name="sunUTC" type="directional">
    <pose>0 0 500 0 -0 0</pose>
    <cast_shadows>true</cast_shadows>
    <intensity>1.0</intensity>
    <direction>0.001 0.625 -0.78</direction>
    <diffuse>0.904 0.904 0.904 1</diffuse>
    <specular>0.271 0.271 0.271 1</specular>
    <attenuation>
      <range>1000</range>
      <linear>0</linear>
      <constant>1</constant>
      <quadratic>0</quadratic>
    </attenuation>
    <spot>
      <inner_angle>0</inner_angle>
      <outer_angle>0</outer_angle>
      <falloff>0</falloff>
    </spot>
  </light>
  <!-- Initial include is intentional: PX4 attaches to this instance. -->
  <include>
    <name>mujoco_uav_delta</name>
    <uri>model://mujoco_uav_delta</uri>
    <pose>0 0 0.3 0 0 0</pose>
  </include>
</world></sdf>
